{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pico: run current file",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/mpremote run ${file}",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Pico: copy current file to board",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/mpremote cp ${file} :",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Pico: REPL",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/mpremote repl",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Pico: list files on board",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/mpremote ls",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
